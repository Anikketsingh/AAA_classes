import { useState, useEffect } from 'react';
import { databases, DATABASE_ID } from '../config/appwrite';
import { Query } from 'appwrite';
import '../styles/components.css';

const COURSES_COLLECTION_ID = '67e58e94003546802bb8';
const CAROUSEL_COLLECTION_ID = '67ef058800352a0744a5';

const CarouselManager = () => {
  const [courses, setCourses] = useState([]);
  const [carouselCourses, setCarouselCourses] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);
  const [saving, setSaving] = useState(false);
  const [saveMessage, setSaveMessage] = useState(null);

  useEffect(() => {
    fetchData();
  }, []);

  const fetchData = async () => {
    try {
      setLoading(true);

      // Fetch all courses
      const coursesResponse = await databases.listDocuments(
        DATABASE_ID,
        COURSES_COLLECTION_ID
      );

      // Fetch carousel courses
      const carouselResponse = await databases.listDocuments(
        DATABASE_ID,
        CAROUSEL_COLLECTION_ID
      );

      // Extract course IDs from carousel documents
      const carouselCourseIds = carouselResponse.documents.map(doc => doc.courseId);

      setCourses(coursesResponse.documents);
      setCarouselCourses(carouselCourseIds);
      setLoading(false);
    } catch (error) {
      console.error('Error fetching data:', error);
      setError('Failed to load courses. Please try again later.');
      setLoading(false);
    }
  };

  const handleCheckboxChange = async (courseId, isChecked) => {
    try {
      setSaving(true);
      setSaveMessage(null);

      if (isChecked) {
        // Add course to carousel
        await databases.createDocument(
          DATABASE_ID,
          CAROUSEL_COLLECTION_ID,
          'unique()',
          { courseId }
        );

        // Update local state
        setCarouselCourses(prev => [...prev, courseId]);
        setSaveMessage('Course added to carousel');
      } else {
        // Find the carousel document with this courseId
        const carouselResponse = await databases.listDocuments(
          DATABASE_ID,
          CAROUSEL_COLLECTION_ID,
          [Query.equal('courseId', courseId)]
        );

        if (carouselResponse.documents.length > 0) {
          const documentId = carouselResponse.documents[0].$id;

          // Delete the document from carousel collection
          await databases.deleteDocument(
            DATABASE_ID,
            CAROUSEL_COLLECTION_ID,
            documentId
          );

          // Update local state
          setCarouselCourses(prev => prev.filter(id => id !== courseId));
          setSaveMessage('Course removed from carousel');
        }
      }
    } catch (error) {
      console.error('Error updating carousel:', error);
      setSaveMessage('Error updating carousel');
    } finally {
      setSaving(false);

      // Clear the message after 3 seconds
      setTimeout(() => {
        setSaveMessage(null);
      }, 3000);
    }
  };

  if (loading) {
    return <div className="carousel-loading">Loading courses...</div>;
  }

  if (error) {
    return <div className="carousel-error">{error}</div>;
  }

  return (
    <div className="carousel-manager">
      <div className="carousel-header">
        <h2 className="carousel-title">Carousel Management</h2>
        <p className="carousel-description">
          Select which courses should appear in the homepage carousel. These courses will be prominently displayed to all visitors.
        </p>
      </div>

      {saveMessage && (
        <div className={`save-message ${saveMessage.includes('Error') ? 'error' : 'success'}`}>
          {saveMessage}
        </div>
      )}

      <div className="carousel-info-box">
        <div className="carousel-info-icon">ℹ️</div>
        <div className="carousel-info-content">
          <h4>How the Carousel Works</h4>
          <p>The homepage carousel showcases your best courses to attract new students. Selected courses will rotate automatically, displaying their title, instructor, and thumbnail image.</p>
          <p>For best results, choose courses with attractive thumbnails and compelling titles.</p>
        </div>
      </div>

      <div className="carousel-courses-container">
        <h3 className="carousel-section-title">Available Courses</h3>
        <p className="carousel-section-description">Check the boxes to add courses to the carousel. Uncheck to remove them.</p>
        
        <div className="carousel-courses-list">
          {courses.length === 0 ? (
            <div className="no-courses-message">
              <div className="no-courses-icon">📚</div>
              <p>No courses available. Add courses first to include them in the carousel.</p>
            </div>
          ) : (
            courses.map(course => (
              <div key={course.$id} className="carousel-course-item">
                <label className="carousel-checkbox-label">
                  <input
                    type="checkbox"
                    checked={carouselCourses.includes(course.$id)}
                    onChange={(e) => handleCheckboxChange(course.$id, e.target.checked)}
                    disabled={saving}
                    className="carousel-checkbox"
                    id={`carousel-checkbox-${course.$id}`}
                  />
                  <div className="carousel-course-info">
                    {course.image ? (
                      <div className="carousel-course-image">
                        <img src={course.image} alt={course.title} />
                      </div>
                    ) : (
                      <div className="carousel-course-image-placeholder">
                        <span>No Image</span>
                      </div>
                    )}
                    <div className="carousel-course-details">
                      <h3 className="carousel-course-title">{course.title}</h3>
                      <p className="carousel-course-instructor">By {course.instructor}</p>
                      <div className="carousel-course-meta">
                        <span className="carousel-course-price">${course.price}</span>
                        <span className="carousel-course-lessons">{course.totalLessons || 0} lessons</span>
                        {course.isPopular && <span className="carousel-course-badge popular">Popular</span>}
                        {course.isNew && <span className="carousel-course-badge new">New</span>}
                      </div>
                    </div>
                  </div>
                </label>
              </div>
            ))
          )}
        </div>
      </div>

      <div className="carousel-preview-section">
        <h3 className="carousel-section-title">Selected Courses ({carouselCourses.length})</h3>
        <p className="carousel-section-description">These courses will appear in the homepage carousel.</p>
        
        {carouselCourses.length === 0 ? (
          <div className="no-selected-courses">
            <div className="no-selected-icon">🎞️</div>
            <p>No courses selected for the carousel. Select at least one course above.</p>
          </div>
        ) : (
          <div className="selected-courses-list">
            {courses
              .filter(course => carouselCourses.includes(course.$id))
              .map(course => (
                <div key={course.$id} className="selected-course-item">
                  {course.image ? (
                    <img src={course.image} alt={course.title} className="selected-course-image" />
                  ) : (
                    <div className="selected-course-image-placeholder">No Image</div>
                  )}
                  <div className="selected-course-info">
                    <h4>{course.title}</h4>
                    <button 
                      className="remove-from-carousel" 
                      onClick={() => handleCheckboxChange(course.$id, false)}
                      disabled={saving}
                    >
                      Remove
                    </button>
                  </div>
                </div>
              ))
            }
          </div>
        )}
      </div>
    </div>
  );
};

export default CarouselManager;